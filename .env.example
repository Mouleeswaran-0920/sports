# Copy to .env and fill in. .env is git-ignored.
#
# WARNING: EXPO_PUBLIC_* variables are inlined into the app bundle at build
# time. They are hidden from the repo, not from anyone holding the built app.
# Route real secrets through a server-side proxy instead.

# Must match the provider of the URL below.
EXPO_PUBLIC_AI_API_KEY=

# OpenRouter -> https://openrouter.ai/api/v1   (sk-or-v1-... keys)
# OpenAI     -> https://api.openai.com/v1      (sk-... keys)
EXPO_PUBLIC_AI_API_URL=https://api.openai.com/v1
